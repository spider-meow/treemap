<Window x:Class="Treemap.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="treemap-overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight">
    <!-- A catalogue tag: ink field, square corners, a heavy orange rule on the left edge. -->
    <Border Background="{StaticResource OverlayInk}" BorderBrush="{StaticResource OverlayRule}"
            BorderThickness="4,0,0,0" CornerRadius="0" Padding="12,8">
        <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource OverlayLabel}"
                                   FontFamily="Bahnschrift SemiCondensed, Segoe UI" FontSize="13" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                   FontFamily="Bahnschrift SemiBold, Segoe UI Semibold" FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource OverlayValue}" />
                                    <Style.Triggers>
                                        <!-- The frame rate is the figure that matters in a game: it takes the highlight. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Label}" Value="FPS" />
                                                <Condition Binding="{Binding Dimmed}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Foreground" Value="{StaticResource OverlayHighlight}" />
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding Dimmed}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource OverlayLabel}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</Window>
