<UserControl x:Class="Treemap.App.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Treemap.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Moniteur" Style="{StaticResource PageTitle}" />
            <TextBlock Text="L'état du PC en direct, sur les deux dernières minutes." Style="{StaticResource Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="380" Margin="0,0,16,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding ValueText}" FontSize="30" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                               MinHeight="34" Margin="0,2,0,10" />
                                    <controls:SparklineControl Height="64" Values="{Binding Values}" Maximum="{Binding Maximum}"
                                                               Stroke="{StaticResource AccentBrush}" Fill="#264F9DF7" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
