<UserControl x:Class="Treemap.App.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Treemap.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Moniteur" Style="{StaticResource PageTitle}" />
            <TextBlock Text="L'état du PC en direct, sur les deux dernières minutes." Style="{StaticResource Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- In-game overlay settings -->
                <Border Style="{StaticResource Card}" Margin="0,0,16,16" HorizontalAlignment="Left" Width="1188">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Content="Afficher l'overlay" IsChecked="{Binding Overlay.Enabled, Mode=TwoWay}" />
                            <TextBlock Text="Overlay en jeu" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"
                                   Text="Petit panneau toujours visible par-dessus le jeu, qui laisse passer les clics. Il fonctionne avec les jeux en fenêtré ou en fenêtré sans bordure, pas en plein écran exclusif." />
                        <WrapPanel>
                            <CheckBox Content="FPS" IsChecked="{Binding Overlay.ShowFps, Mode=TwoWay}" Margin="0,0,24,8" />
                            <CheckBox Content="Processeur" IsChecked="{Binding Overlay.ShowCpu, Mode=TwoWay}" Margin="0,0,24,8" />
                            <CheckBox Content="Carte graphique" IsChecked="{Binding Overlay.ShowGpu, Mode=TwoWay}" Margin="0,0,24,8" />
                            <CheckBox Content="Température GPU" IsChecked="{Binding Overlay.ShowGpuTemperature, Mode=TwoWay}" Margin="0,0,24,8" />
                            <CheckBox Content="Mémoire" IsChecked="{Binding Overlay.ShowMemory, Mode=TwoWay}" Margin="0,0,24,8" />
                            <CheckBox Content="Mémoire vidéo" IsChecked="{Binding Overlay.ShowVideoMemory, Mode=TwoWay}" Margin="0,0,24,8" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="Position" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox ItemsSource="{Binding Overlay.Corners}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Overlay.Corner, Mode=TwoWay}" Width="190" />
                            <TextBlock Text="Opacité" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="28,0,10,0" />
                            <Slider Minimum="{Binding Overlay.MinOpacity, Mode=OneWay}" Maximum="1" Width="180" VerticalAlignment="Center"
                                    Value="{Binding Overlay.Opacity, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Overlay.FpsStatusText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0" />
                        <Button Content="Relancer en administrateur" Command="{Binding Overlay.RelaunchAsAdminCommand}"
                                HorizontalAlignment="Left" Margin="0,8,0,0"
                                Visibility="{Binding Overlay.CanRelaunchAsAdmin, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Overlay.HotkeyHint}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="380" Margin="0,0,16,16">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding ValueText}" FontSize="30" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                               MinHeight="34" Margin="0,2,0,10" />
                                    <controls:SparklineControl Height="64" Values="{Binding Values}" Maximum="{Binding Maximum}"
                                                               Stroke="{StaticResource AccentBrush}" Fill="{StaticResource AccentFillBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
