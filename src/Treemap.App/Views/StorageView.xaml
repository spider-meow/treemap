<UserControl x:Class="Treemap.App.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Treemap.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Stockage" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Où partent les Go : analyse d'un disque ou d'un dossier, en lecture seule."
                       Style="{StaticResource Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Toolbar and scan status -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                          DisplayMemberPath="Display" Width="360" IsEnabled="{Binding IsIdle}" />
                <Button Content="Dossier…" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                <Button Content="Analyser" Command="{Binding ScanCommand}" Margin="8,0,0,0" />
                <Button Content="Annuler" Command="{Binding CancelCommand}" Margin="8,0,0,0" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0"
                         Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource TextPrimary}" Margin="0,10,0,0"
                       Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding InfoText}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Folder tree -->
            <Border Style="{StaticResource Card}" Padding="8">
                <TreeView ItemsSource="{Binding RootNodes}" Background="Transparent" BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <!-- Fixed columns: the tree item header does not stretch to the panel width, so a star column would collapse. -->
                            <Grid Margin="0,2,4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="38" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFolder}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="{StaticResource TextPrimary}"
                                           TextAlignment="Right" Margin="0,0,8,0" />
                                <ProgressBar Grid.Column="2" Height="4" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                             Foreground="{StaticResource AccentBrush}" Value="{Binding Fraction, Mode=OneWay}" />
                                <TextBlock Grid.Column="3" Text="{Binding PercentText}" Style="{StaticResource Muted}"
                                           TextAlignment="Right" />
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>

            <!-- Treemap and known hogs -->
            <TabControl Grid.Column="2" SelectedIndex="{Binding RightTabIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                <TabItem Header="Carte">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Left" Content="↑ Dossier parent" Command="{Binding GoUpCommand}" Margin="0,0,12,0" />
                            <Button DockPanel.Dock="Right" Content="Afficher dans l'Explorateur" Command="{Binding RevealCommand}" />
                            <TextBlock Text="{Binding CurrentPath}" Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                        </DockPanel>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                            <Grid>
                                <controls:TreemapControl Folder="{Binding CurrentFolderNode}"
                                                         HoverChanged="OnTreemapHover" NodeClicked="OnTreemapClicked" />
                                <TextBlock Text="Rien à afficher pour l'instant. Lance une analyse." Style="{StaticResource Muted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="2" Text="{Binding HoverText}" Style="{StaticResource Muted}" MinHeight="20"
                                   TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                    </Grid>
                </TabItem>

                <TabItem Header="{Binding HogsHeader}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="Catégories connues d'occupation d'espace repérées dans l'analyse. Rien n'est supprimé par treemap : ce sont des pistes à vérifier." />
                            <TextBlock Text="Aucun suspect connu trouvé dans cette analyse." Style="{StaticResource Muted}"
                                       Visibility="{Binding NoHogs, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Hogs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                            <StackPanel>
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ShareText}" Style="{StaticResource Muted}" Margin="0,0,12,0" />
                                                        <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimary}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Explanation}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                                <TextBlock Text="{Binding Advice}" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding CountText}" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                                                <ItemsControl ItemsSource="{Binding Locations}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,2">
                                                                <Button DockPanel.Dock="Right" Content="Afficher" Padding="8,2" Margin="8,0,0,0"
                                                                        Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding Path}" />
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Margin="12,0,0,0"
                                                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Path}" Style="{StaticResource Muted}"
                                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Path}" />
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding MoreText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
