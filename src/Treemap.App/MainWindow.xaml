<Window x:Class="Treemap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Treemap.App.Views"
        Title="treemap" Width="1280" Height="820" MinWidth="960" MinHeight="600"
        Background="{StaticResource AppBackground}"
        Foreground="{StaticResource TextPrimary}">
    <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Margin="16"
                Background="Transparent" BorderThickness="0">
        <TabItem Header="Composants">
            <views:ComponentsView DataContext="{Binding Components}" Margin="0,16,0,0" />
        </TabItem>
        <TabItem Header="Stockage">
            <views:StorageView DataContext="{Binding Storage}" Margin="0,16,0,0" />
        </TabItem>
    </TabControl>
</Window>
